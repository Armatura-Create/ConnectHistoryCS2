# Локальная проверка ЯДРА плагина: без hl2sdk, без Metamod, без MySQL.
#
# Смысл раздельной сборки в том, что почти вся логика (конфиг, SQL-тексты,
# арифметика сессий, цвета чата, IP, спул) движка не требует, а собрать hl2sdk
# на машине разработчика под macOS нельзя вовсе. Всё, что зависит от SDK и от
# libmariadb, живёт в src/mm и src/db и проверяется только в CI.
#
#   make -f Makefile.tests && ./build-tests/ch_tests

CXX      ?= c++
CXXSTD   ?= -std=c++17
CXXFLAGS ?= $(CXXSTD) -O1 -g -Wall -Wextra -Wpedantic -Werror
INCLUDES  = -Isrc -Isrc/vendorcfg -Ivendor/doctest/doctest -Ivendor/json/single_include \
            -Ivendor/libmaxminddb/include -Ivendor/libmaxminddb/src

OUT       = build-tests
BIN       = $(OUT)/ch_tests
DUMPER    = $(OUT)/dump_defaults

CORE_SRC  = $(wildcard src/core/*.cpp) $(wildcard src/core/util/*.cpp)
TEST_SRC  = $(wildcard tests/*.cpp)
SRC       = $(CORE_SRC) $(TEST_SRC)
OBJ       = $(patsubst %.cpp,$(OUT)/%.o,$(SRC))

# libmaxminddb собирается одним файлом-обёрткой (он же добавляет открытие из
# памяти вместо mmap). Предупреждения чужого кода не наши — -Werror тут не к месту.
C_SRC     = src/core/geoip_maxminddb.c vendor/libmaxminddb/src/data-pool.c
C_OBJ     = $(patsubst %.c,$(OUT)/%.o,$(C_SRC))
OBJ      += $(C_OBJ)
CC       ?= cc
CFLAGS   ?= -std=c99 -O1 -g -w

all: $(BIN)

$(BIN): $(OBJ)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJ)

# Дефолтные конфиги для релизного архива. Отдельная цель, а не часть all:
# нужна только сборке релиза, а тесты гоняют на каждом коммите.
CORE_OBJ  = $(patsubst %.cpp,$(OUT)/%.o,$(CORE_SRC)) $(C_OBJ)

dump-defaults: $(DUMPER)

$(DUMPER): $(OUT)/tools/dump_defaults.o $(CORE_OBJ)
	$(CXX) $(CXXFLAGS) -o $@ $^

$(OUT)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(OUT)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Игровая сборка идёт с -fno-exceptions (так собран весь hl2sdk), и в этом режиме
# nlohmann/json на ошибке зовёт std::abort() вместо броска. То есть кривой конфиг
# или битая строка спула убивали бы сервер вместо отката на значения по умолчанию.
#
# Тесты собираются С исключениями (их требует doctest), поэтому проверка отдельная.
#
# Стандарт здесь c++20, а не c++17: именно так ядро компилирует AMBuild. Проверка
# закрывает сразу две дыры между локальной сборкой и игровой — исключения и стандарт.
GAMEFLAGS ?= -std=c++20 -fno-exceptions -fsyntax-only

# AMBuilder перечисляет исходники ядра руками, а тесты берут их маской. Забытый
# в AMBuilder файл собирается локально и падает только в игровой сборке - то есть
# через несколько минут CI и совсем не там, где ошиблись.
sources-check:
	@for f in $(CORE_SRC); do \
		grep -q "'$$f'" AMBuilder || { \
			echo "AMBuilder не собирает $$f"; exit 1; }; \
	done
	@echo "AMBuilder собирает все файлы ядра"

noexcept-check:
	@for f in $(CORE_SRC); do \
		$(CXX) $(GAMEFLAGS) $(INCLUDES) $$f || exit 1; \
	done
	@echo "core compiles as the game build does (c++20, -fno-exceptions)"

clean:
	rm -rf $(OUT)

.PHONY: all clean noexcept-check dump-defaults sources-check
